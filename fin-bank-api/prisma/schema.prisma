datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. MEVCUT ENUM VE MODELLER
// ==========================================
enum WhitelistStatus {
  PENDING
  COMPLETED
}

model AuthorizedPersonnel {
  id        String          @id @default(uuid())
  email     String          @unique
  name      String
  surname   String
  roleId    String
  role      Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branchId  Int             // Soru işareti kalktı: kesinlikle dolu (number)
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status    WhitelistStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("authorized_personnel")
}

model User {
  id                       String             @id @default(uuid())
  name                     String
  surname                  String
  username                 String             @unique
  email                    String             @unique
  password                 String
  userRole                 UserRole?
  userPermissions          UserPermission[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  notifications            Notification[]

  branchId                 Int                // Soru işareti kalktı: kesinlikle dolu (number)
  branch                   Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAccountingRecords AccountingRecord[] @relation("RecordCreatedBy")

  createdCustomers         Customer[]         @relation("CustomerCreatedBy")
  updatedCustomers         Customer[]         @relation("CustomerUpdatedBy")
  createdAccounts          Account[]          @relation("AccountCreatedBy")
  updatedAccounts          Account[]          @relation("AccountUpdatedBy")

  @@map("users")
}
model Role {
  id                  String                @id @default(uuid())
  name                String                @unique
  userRoles           UserRole[]
  rolePermissions     RolePermission[]
  authorizedPersonnel AuthorizedPersonnel[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @unique
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

enum NotificationType {
  INFO
  WARNING
  APPROVAL_REQUIRED
  SECURITY
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ==========================================
// 2. BANKACILIK PARAMETRİK MODELLERİ
// ==========================================
enum AccountType {
  DEMAND  // Vadesiz
  TIME    // Vadeli
}

enum RenewalType {
  PRINCIPAL_AND_INTEREST
  PRINCIPAL_ONLY
  CLOSE
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

model Branch {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique @db.VarChar(10)
  name                String                @db.VarChar(100)
  city                String                @db.VarChar(50)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())

  users               User[]
  customers           Customer[]
  accounts            Account[]
  accountingRecords   AccountingRecord[]
  authorizedPersonnel AuthorizedPersonnel[]

  @@map("branches")
}


// 1. Döviz / Para Birimleri Tablosu
model Currency {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(3) // TRY, USD, EUR, GBP
  name      String   @db.VarChar(50)        // Türk Lirası, ABD Doları, Euro
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  accounts          Account[]
  productCurrencies ProductCurrency[]

  @@map("currencies")
}

// 2. Ürün Tablosu (Para biriminden bağımsız genel ürün kuralları)
model Product {
  id          Int               @id @default(autoincrement())
  code        String            @unique @db.VarChar(20) // DEMAND_DEPOSIT, TIME_DEPOSIT
  name        String            @db.VarChar(100)        // Vadesiz Mevduat Hesabı
  type        AccountType                               // DEMAND / TIME
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())

  accounts          Account[]
  productCurrencies ProductCurrency[]

  @@map("products")
}

// 3. Ürün - Döviz İlişki & Kural Tablosu
model ProductCurrency {
  id          Int      @id @default(autoincrement())
  productId   Int
  currencyId  Int
  minInterest Decimal? @db.Decimal(5, 2)
  maxInterest Decimal? @db.Decimal(5, 2)
  isActive    Boolean  @default(true)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency    Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@unique([productId, currencyId])
  @@map("product_currencies")
}

model Customer {
  id              Int       @id @default(autoincrement())
  customerNumber  Int       @unique
  identityNumber  String    @unique @db.VarChar(11)
  firstName       String    @db.VarChar(50)
  lastName        String    @db.VarChar(50)
  isActive        Boolean   @default(true)
  
  branchId        Int
  branch          Branch    @relation(fields: [branchId], references: [id])

  createdAt       DateTime  @default(now())
  createdById     String
  createdBy       User      @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime  @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])

  accounts        Account[]

  @@map("customers")
}

model Account {
  id            Int           @id @default(autoincrement())
  accountNumber Int
  iban          String        @unique @db.VarChar(34)
  name          String        @db.VarChar(100)
  balance       Decimal       @default(0.00) @db.Decimal(15, 2)
  status        AccountStatus @default(ACTIVE)

  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id])

  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])

  productId     Int
  product       Product       @relation(fields: [productId], references: [id])

 currencyId    Int
currency      Currency      @relation(fields: [currencyId], references: [id])
accountingRecords AccountingRecord[]

  interestRate  Decimal?      @db.Decimal(5, 2)
  renewalType   RenewalType?
  maturityStart DateTime?
  maturityEnd   DateTime?
  maturityDays  Int?

  createdAt     DateTime      @default(now())
  createdById   String
  createdBy     User          @relation("AccountCreatedBy", fields: [createdById], references: [id])
  updatedAt     DateTime      @updatedAt
  updatedById   String?
  updatedBy     User?         @relation("AccountUpdatedBy", fields: [updatedById], references: [id])

  @@unique([customerId, accountNumber])
  @@map("accounts")
}

enum TransactionType {
  DEPOSIT     // Para Yatırma
  WITHDRAWAL  // Para Çekme
  TRANSFER    // Para Transferi
  OTHER       // Diğer İşlemler
}

model AccountingRecord {
  id              Int             @id @default(autoincrement())
  receiptNumber   String          @unique @db.VarChar(50) // Fiş / Referans Numarası (Örn: "FIS-20260827-0001")
  type            TransactionType // İşlem Türü
  amount          Decimal         @db.Decimal(15, 2)      // İşlem Tutarı
  description     String          @db.VarChar(255)        // İşlem Açıklaması
  transactionDate DateTime        @default(now())         // İşlem Tarihi

  // Şube Bilgisi
  branchId        Int
  branch          Branch          @relation(fields: [branchId], references: [id])

  // İsteğe Bağlı İlgili Hesap (Hangi hesaba yapıldı)
  accountId       Int?
  account         Account?        @relation(fields: [accountId], references: [id])

  // İşlemi Yapan Personel
  createdById     String
  createdBy       User            @relation("RecordCreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime        @default(now())

  @@map("accounting_records")
}