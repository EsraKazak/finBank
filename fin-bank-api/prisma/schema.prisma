datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. MEVCUT ENUM VE MODELLER
// ==========================================
enum WhitelistStatus {
  PENDING
  COMPLETED
}

model AuthorizedPersonnel {
  id        String          @id @default(uuid())
  email     String          @unique
  name      String
  surname   String
  roleId    String
  role      Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status    WhitelistStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("authorized_personnel")
}

model User {
  id              String           @id @default(uuid())
  name            String
  surname         String
  username        String           @unique
  email           String           @unique
  password        String
  userRole        UserRole?
  userPermissions UserPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  notifications   Notification[]

  // Şube İlişkisi: Mevcut verilerin silinmemesi için opsiyonel (Int?)
  branchId        Int?
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Audit Log İlişkileri
  createdCustomers Customer[]      @relation("CustomerCreatedBy")
  updatedCustomers Customer[]      @relation("CustomerUpdatedBy")
  createdAccounts  Account[]       @relation("AccountCreatedBy")
  updatedAccounts  Account[]       @relation("AccountUpdatedBy")

  @@map("users")
}

model Role {
  id                  String                @id @default(uuid())
  name                String                @unique
  userRoles           UserRole[]
  rolePermissions     RolePermission[]
  authorizedPersonnel AuthorizedPersonnel[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @unique
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

enum NotificationType {
  INFO
  WARNING
  APPROVAL_REQUIRED
  SECURITY
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ==========================================
// 2. YENİ BANKACILIK ENUMLARI VE MODELLERİ
// ==========================================
enum AccountType {
  DEMAND  // Vadesiz
  TIME    // Vadeli
}

enum RenewalType {
  PRINCIPAL_AND_INTEREST  // Anapara + Faiz uzat
  PRINCIPAL_ONLY          // Sadece anapara uzat
  CLOSE                   // Vade sonunda kapat
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

model Branch {
  id        Int        @id @default(autoincrement())
  code      String     @unique @db.VarChar(10) // Örn: "001", "002", "003"
  name      String     @db.VarChar(100)        // Örn: "Kadıköy Şubesi"
  city      String     @db.VarChar(50)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  users     User[]
  customers Customer[]
  accounts  Account[]

  @@map("branches")
}

model Product {
  id          Int         @id @default(autoincrement())
  code        String      @unique @db.VarChar(20) // Örn: "TIME-TRY", "DEMAND-TRY"
  name        String      @db.VarChar(100)
  type        AccountType
  currency    String      @db.VarChar(3)          // TRY, USD, EUR
  minInterest Decimal?    @db.Decimal(5, 2)
  maxInterest Decimal?    @db.Decimal(5, 2)
  isActive    Boolean     @default(true)

  accounts    Account[]

  @@map("products")
}

model Customer {
  id              Int       @id @default(autoincrement())
  customerNumber  Int       @unique // Örn: 10000001
  identityNumber  String    @unique @db.VarChar(11)
  firstName       String    @db.VarChar(50)
  lastName        String    @db.VarChar(50)
  isActive        Boolean   @default(true)
  
  // Şube İlişkisi
  branchId        Int
  branch          Branch    @relation(fields: [branchId], references: [id])

  // Audit Log Bilgileri
  createdAt       DateTime  @default(now())
  createdById     String
  createdBy       User      @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime  @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])

  accounts        Account[]

  @@map("customers")
}

model Account {
  id             Int           @id @default(autoincrement())
  accountNumber  Int           // 1001, 1002 (Müşteri bazında artar)
  iban           String        @unique @db.VarChar(34)
  name           String        @db.VarChar(100)
  currency       String        @db.VarChar(3)
  balance        Decimal       @default(0.00) @db.Decimal(15, 2)
  status         AccountStatus @default(ACTIVE)

  // İlişkiler
  customerId     Int
  customer       Customer      @relation(fields: [customerId], references: [id])

  branchId       Int
  branch         Branch        @relation(fields: [branchId], references: [id])

  productId      Int
  product        Product       @relation(fields: [productId], references: [id])

  // Vadeli Bilgileri
  interestRate   Decimal?      @db.Decimal(5, 2)
  renewalType    RenewalType?
  maturityStart  DateTime?
  maturityEnd    DateTime?
  maturityDays   Int?

  // Audit Log Bilgileri
  createdAt      DateTime      @default(now())
  createdById    String
  createdBy      User          @relation("AccountCreatedBy", fields: [createdById], references: [id])
  updatedAt      DateTime      @updatedAt
  updatedById    String?
  updatedBy      User?         @relation("AccountUpdatedBy", fields: [updatedById], references: [id])

  @@unique([customerId, accountNumber])
  @@map("accounts")
}